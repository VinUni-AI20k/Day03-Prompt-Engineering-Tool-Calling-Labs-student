      "turns": [
        {
          "role": "user",
          "content": "Nội dung bản tin: Hôm nay nhóm đã hoàn thành demo. Nơi nhận là kênh Telegram đã cấu hình."
        },
        {
          "role": "user",
          "content": "Chuẩn bị đăng bản tin đó, nhưng hỏi mình xác nhận có/không trước khi gửi."
        }
