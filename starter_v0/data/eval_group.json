      "phase": "B",
      "failure_type": "wrong_arg_value",
      "metadata": {
        "what_it_tests": "G_account_correction"
      },
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "elonmusk",
              "limit": 2
            }
          }
