    {
      "id": "G_send_confirmation",
      "phase": "B",
      "failure_type": "wrong_boundary",
      "metadata": {
        "what_it_tests": "G_send_confirmation"
      },
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
