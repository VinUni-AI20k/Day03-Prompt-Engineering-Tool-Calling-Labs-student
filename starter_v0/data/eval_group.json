      "turns": [
        {
          "role": "user",
          "content": "Lấy 8 tweet mới nhất của sama"
        },
        {
          "role": "user",
          "content": "Đổi thành 2 tweet"
        },
        {
          "role": "user",
          "content": "Vẫn tài khoản sama nhé"
        }
      ]
    },
    {
      "id": "G_time_carryover",
      "phase": "B",
      "failure_type": "wrong_arg_value",
      "metadata": {
        "what_it_tests": "G_time_carryover"
